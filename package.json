  "repository": {
    "type": "git",
    "url": "git+https://github.com/tilap/agent-deck.git"
  },
  "bugs": {
    "url": "https://github.com/tilap/agent-deck/issues"
  },
  "homepage": "https://github.com/tilap/agent-deck#readme",
  "keywords": [
    "claude-code",
    "cursor",
    "agents",
    "skills",
    "plugins",
    "mcp",
    "marketplace",
    "lockfile"
  ]
}
