{
  "name": "@toolmesh/agent-deck",
  "version": "0.1.0",
  "description": "Install and sync Claude Code and Cursor plugins, skills, agents and MCP servers into a project from a lockfile.",
  "type": "module",
  "author": "Julien La Vinh",
  "license": "MIT",
  "engines": {
    "node": ">=22.14"
  },
  "bin": {
    "agent-deck": "bin/agent-deck.js"
  },
  "files": [
